<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Permiso para activar el motor de vibración del teléfono -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Permiso para acceder a la cámara nativa -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Permiso para transmitir audio en línea desde internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Declara que la app puede usar la cámara, pero no impedirá instalarla si el teléfono no tiene una -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IUDigitalRadio">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.IUDigitalRadio"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>